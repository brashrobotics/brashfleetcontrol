FLEET_PERSISTENCE=postgres
FLEET_SITE_ID=plant-a
FLEET_LEADER_LEASE_MS=15000
FLEET_LEADER_POLL_MS=5000
DATABASE_URL=postgresql://brash:brash@127.0.0.1:5432/brash_fleet
# DATABASE_URL_FILE=/run/secrets/brash-database-url
DATABASE_SCHEMA=brash_plant_a
TEST_DATABASE_URL=postgresql://brash:brash@127.0.0.1:5432/brash_fleet_test
FLEET_INTEGRATION_WEBHOOK_URL=https://erp.example.com/hooks/brash-fleet
FLEET_INTEGRATION_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# FLEET_INTEGRATION_WEBHOOK_SECRET_FILE=/run/secrets/brash-webhook-secret
FLEET_INTEGRATION_WEBHOOK_TIMEOUT_MS=10000
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_STARTUP_TIMEOUT_MS=30000
FLEET_PORT=4273
FLEET_HOST=127.0.0.1
# Docker Compose host-port overrides when defaults are already occupied:
# FLEET_PUBLISHED_PORT=4274
# ROBOT_EMULATOR_PUBLISHED_PORT=4281
# Use the separate robot emulator instead of the in-process simulator:
# FLEET_ROBOT_ADAPTER=http
# FLEET_ROBOT_ADAPTER_URL=http://127.0.0.1:4280
# FLEET_ROBOT_ADAPTER_TOKEN_FILE=/run/secrets/brash-robot-adapter-token
# FLEET_ROBOT_ADAPTER_TIMEOUT_MS=5000
# FLEET_ROBOT_ADAPTER_POLL_MS=100
# VDA 5050 v3 + MQTT adapter (use mqtts/wss and device credentials outside development):
# FLEET_ROBOT_ADAPTER=vda5050
# FLEET_MQTT_URL=mqtt://127.0.0.1:1883
# FLEET_MQTT_USERNAME_FILE=/run/secrets/brash-mqtt-username
# FLEET_MQTT_PASSWORD_FILE=/run/secrets/brash-mqtt-password
# FLEET_MQTT_CLIENT_ID=brash-fleet-plant-a
# FLEET_MQTT_CONNECT_TIMEOUT_MS=10000
# FLEET_MQTT_RECONNECT_MS=1000
# FLEET_MQTT_ALLOW_INSECURE=true # isolated production-like lab only
# FLEET_VDA_INTERFACE=vda5050
# FLEET_VDA_MAJOR_VERSION=v3
# FLEET_VDA_ACK_TIMEOUT_MS=5000
# FLEET_VDA_INITIAL_STATE_TIMEOUT_MS=10000
# FLEET_VDA_ROBOTS=[{"manufacturer":"BRASH","serialNumber":"EMU-01","descriptor":{"robotId":"EMU-01","displayName":"Atlas","vendor":"BRASH","model":"VDA5050-AMR","capabilities":{"actions":["pallet_transport"],"maxPayloadKg":800,"allowedZones":["warehouse"],"supportsCancellation":true,"adapterProtocolVersion":"VDA5050/3.0.0"}}}]
ROBOT_EMULATOR_HOST=127.0.0.1
ROBOT_EMULATOR_PORT=4280
# ROBOT_EMULATOR_TOKEN_FILE=/run/secrets/brash-robot-adapter-token
ROBOT_EMULATOR_START_DELAY_MS=500
ROBOT_EMULATOR_MISSION_DURATION_MS=8000
ROBOT_EMULATOR_MOTION_INTERVAL_MS=250
ROBOT_EMULATOR_HEARTBEAT_MS=1000
# ROBOT_EMULATOR_MQTT_URL=mqtt://127.0.0.1:1883
# ROBOT_EMULATOR_MQTT_USERNAME_FILE=/run/secrets/brash-mqtt-username
# ROBOT_EMULATOR_MQTT_PASSWORD_FILE=/run/secrets/brash-mqtt-password
# Docker Compose host-port overrides:
# MQTT_PUBLISHED_PORT=1884
# VDA_FLEET_PUBLISHED_PORT=4275
# Production identity: configure all three OIDC values together.
# FLEET_OIDC_ISSUER=https://identity.example.com/realms/factory
# FLEET_OIDC_AUDIENCE=brash-fleet-api
# FLEET_OIDC_JWKS_URI=https://identity.example.com/realms/factory/protocol/openid-connect/certs
# FLEET_OIDC_ROLE_CLAIM=brash_role
# FLEET_OIDC_SITES_CLAIM=brash_sites
# Static service-token fallback can be mounted instead of placed in the environment:
# FLEET_API_TOKENS_FILE=/run/secrets/brash-api-tokens.json
