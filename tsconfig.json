{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@brash/contracts": ["./packages/contracts/src/index.ts"],
      "@brash/domain": ["./packages/domain/src/index.ts"],
      "@brash/application": ["./packages/application/src/index.ts"],
      "@brash/robot-adapter-sdk": ["./packages/robot-adapter-sdk/src/index.ts"],
      "@brash/simulator-adapter": ["./packages/adapters/simulator/src/index.ts"],
      "@brash/http-robot-adapter": ["./packages/adapters/rest/src/index.ts"],
      "@brash/mqtt-adapter": ["./packages/adapters/mqtt/src/index.ts"],
      "@brash/vda5050-adapter": ["./packages/adapters/vda5050/src/index.ts"],
      "@brash/customer-adapter-template": ["./packages/adapters/customer-template/src/index.ts"],
      "@brash/persistence": ["./packages/persistence/src/index.ts"],
      "@brash/config": ["./packages/config/src/index.ts"],
      "@brash/test-kit": ["./packages/test-kit/src/index.ts"],
      "@brash/observability": ["./packages/observability/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
